# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- City Brain agent model -------------------------------------------------
# With no key, the agents fall back to built-in rules (the city still runs).
# Free option: Gemini — https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=
# Claude (used for the demo recording)
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=google      # google | anthropic | ollama | rules (default: auto-detect)
# LLM_MODEL=               # override, e.g. gemini-2.5-flash or claude-haiku-5-5
# LLM_RPM=12               # max pipeline model calls per minute
